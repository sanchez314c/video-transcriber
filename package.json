{
  "name": "video-transcriber",
  "version": "1.0.0",
  "description": "Cross-platform video transcription tool using OpenAI Whisper",
  "homepage": "https://github.com/sanchez314c/video-transcriber",
  "main": "src/main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "electron . --dev --no-sandbox",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:mac-intel": "electron-builder --mac --x64",
    "build:mac-arm": "electron-builder --mac --arm64",
    "build:mac-universal": "electron-builder --mac --universal",
    "build:linux": "electron-builder --linux",
    "dist": "electron-builder -mwl",
    "dist:all": "electron-builder --mac --win --linux",
    "dist:current": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:win:msi": "electron-builder --win --config.win.target=msi",
    "dist:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "video",
    "transcription",
    "whisper",
    "ai",
    "electron",
    "cross-platform"
  ],
  "author": {
    "name": "J. Michaels",
    "email": "sanchez314c@speedysloth.com",
    "url": "https://github.com/sanchez314c"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dmg-builder": "^24.13.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-reload": "^2.0.0-alpha.1",
    "globals": "^17.5.0"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.4",
    "@ffmpeg/ffmpeg": "^0.12.7",
    "@ffmpeg/util": "^0.12.1",
    "ffmpeg-static": "^5.3.0",
    "fs-extra": "^11.2.0",
    "nodejs-whisper": "^0.3.0",
    "which": "^4.0.0"
  },
  "build": {
    "appId": "com.videotranscriber.app",
    "productName": "Video Transcriber",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "binaries/**/*",
      "node_modules/@ffmpeg/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "publisherName": "Video Transcriber",
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "icon": "resources/icons/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "description": "Cross-platform video transcription tool",
      "desktop": {
        "StartupNotify": "true",
        "Encoding": "UTF-8",
        "Type": "Application",
        "Categories": "AudioVideo;Audio;Video;"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    },
    "snap": {
      "grade": "stable",
      "summary": "Cross-platform video transcription tool using OpenAI Whisper"
    },
    "publish": null
  }
}
